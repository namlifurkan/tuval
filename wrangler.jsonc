{
  // Tuval builds to a folder of static files. The one thing the host has to know is that
  // /b/<room> and /dashboard are routes inside the app, not missing files, so an unknown path is
  // answered with index.html instead of a 404.
  //
  // The worker exists for one reason: a link posted anywhere turns into a card, and the crawler
  // that builds that card does not run JavaScript. Three addresses get their tags filled in on
  // the way out; everything else is the static file, untouched.
  "name": "tuval",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  // Every page here writes its canonical without a trailing slash, and the default asset
  // handling answered that exact URL with a 307 to the slashed one. So the address we asked
  // search engines to index was never the address that served the page. This makes the
  // unslashed form the one that answers 200, and the slashed form the redirect.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
