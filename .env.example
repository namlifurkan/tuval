# Realtime multiplayer (start the server with: npm run collab)
VITE_COLLAB_URL=ws://localhost:1234

# Supabase — accounts, shared board list, image storage, snapshot backup.
# Leave both blank and Tuval keeps working local-first, boards stay in this browser.
# Create a project at supabase.com, run supabase/schema.sql in the SQL editor, then paste:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
