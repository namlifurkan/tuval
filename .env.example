# Realtime multiplayer (start the server with: npm run collab)
VITE_COLLAB_URL=ws://localhost:1234

# The backend — accounts, shared board list, image storage, snapshot backup.
# Leave both blank and Tuval keeps working local-first: boards stay in this browser, no account.
#
# Either a hosted Supabase project, or the same open-source services on your own machine —
# deploy/compose.yml brings them up and docs/self-hosting.md walks through it. Nothing here knows
# the difference: it is one URL and one key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
