# cp .env.example .env, then fill the three generated lines with:
#
#   node keys.mjs
#
# JWT_SECRET signs the tokens; ANON_KEY and SERVICE_KEY are tokens signed with it. Change the
# secret and both keys have to be minted again, because every service checks them against it.

POSTGRES_PASSWORD=change-me
JWT_SECRET=
ANON_KEY=
SERVICE_KEY=

# Where this stack answers, and where the app it serves lives. On one machine they are the same
# host on two ports; behind a domain, put the real addresses here.
PUBLIC_PORT=8000
PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:5173

# Confirmation and sign-in links go out through this. Without it nobody can finish signing up,
# which is the point: an address nobody confirmed is a claim.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Realtime only. The encryption key has to be exactly 16 characters (it is an AES-128 key and
# the service dies with "Bad key size" otherwise); the other is any long random string.
REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=
